FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer WebM audio add-in\0"
      VALUE "FileVersion", "@WebM_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_webm\0"
      VALUE "OriginalFilename", "ttp_webm.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild WebM\0"
      VALUE "ProductVersion", "@WebM_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
